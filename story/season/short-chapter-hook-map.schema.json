{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linan Spring Letter 648 Short Chapter Hook Map",
  "type": "object",
  "required": ["schema_version", "status", "scope", "episode_count", "chapters_per_episode", "chapter_total", "duration_seconds_target", "entries", "next_gate"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "status": {"type": "string", "enum": ["SEASON-DRAFT", "EPISODE-DRAFT", "LOCKED"]},
    "scope": {"type": "string", "const": "P2 S2-C 648 short chapter hook map"},
    "episode_count": {"type": "integer", "const": 36},
    "chapters_per_episode": {"type": "integer", "const": 18},
    "chapter_total": {"type": "integer", "const": 648},
    "duration_seconds_target": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2},
    "next_gate": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 648,
      "maxItems": 648,
      "items": {
        "type": "object",
        "required": ["chapter_id", "episode_id", "sequence", "duration_seconds", "pov_id", "pov_name", "function", "cold_hook", "goal_obstacle", "evidence_or_relationship_action", "choice_cost", "tail_hook_type", "tail_hook", "next_chase", "state_delta"],
        "properties": {
          "chapter_id": {"type": "string", "pattern": "^S1-E[0-9]{2}-M[0-9]{2}$"},
          "episode_id": {"type": "string", "pattern": "^S1-E[0-9]{2}$"},
          "sequence": {"type": "integer", "minimum": 1, "maximum": 18},
          "duration_seconds": {"type": "integer", "minimum": 120, "maximum": 180},
          "pov_id": {"type": "string", "pattern": "^CHR-[A-Z0-9-]+$"},
          "pov_name": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1},
          "cold_hook": {"type": "string", "minLength": 1},
          "goal_obstacle": {"type": "string", "minLength": 1},
          "evidence_or_relationship_action": {"type": "string", "minLength": 1},
          "choice_cost": {"type": "string", "minLength": 1},
          "tail_hook_type": {"type": "string", "minLength": 1},
          "tail_hook": {"type": "string", "minLength": 1},
          "next_chase": {"type": "string", "minLength": 1},
          "state_delta": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
